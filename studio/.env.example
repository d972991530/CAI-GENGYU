# 镜坊后端环境变量（全部可选），复制为 .env 后用你的进程管理器加载
PORT=8787
# 设置后，前端需要输入此口令才能访问 /api（公开部署时强烈建议设置）
STUDIO_TOKEN=
# 加密保存 API Key 的主口令；不设置则自动生成并保存在 .data/.secret
STUDIO_SECRET=
# 也可以直接用环境变量提供 Key（优先使用在网页设置里保存的 Key）
GEMINI_API_KEY=
FAL_KEY=
# 七七八AI（即梦 5.0 Pro）
LK888_API_KEY=
LK888_BASE_URL=https://api.lk888.ai
# 本服务的公网地址；设置后参考图以临时公网 URL 提供给第三方平台（否则以 data URI 内联）
PUBLIC_BASE_URL=
PUBLIC_REF_TTL_MIN=60
# 后端同时执行的生成任务数
JOB_CONCURRENCY=3
DATA_DIR=./.data
