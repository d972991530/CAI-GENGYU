{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "H3 DiT · FL2VA（文生 / 首帧 / 尾帧 / 首尾帧）"},
    "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3-VL 32B 文本/多模态编码器"},
    "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "视频 VAE"},
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "音频 VAE"},
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Turbo 8 步 LoRA（可选，脚本 turbo=false 时会删掉）"},
    "inputs": {"model": ["1", 0], "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", "strength_model": 1.0}
  },
  "5": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {"title": "ModelSamplingMiniMaxH3"},
    "inputs": {"model": ["6", 0], "shift_video": 12.0, "shift_audio": 3.0}
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": {"title": "首帧 first_frame（可选）"},
    "inputs": {"image": "h3_refs/keyframes/first.png"}
  },
  "11": {
    "class_type": "LoadImage",
    "_meta": {"title": "尾帧 last_frame（可选）"},
    "inputs": {"image": "h3_refs/keyframes/last.png"}
  },
  "20": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {"title": "H3 Image to Video"},
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": 124,
      "first_frame": ["10", 0],
      "last_frame": ["11", 0]
    }
  },
  "21": {
    "class_type": "LoadAudio",
    "_meta": {"title": "音乐切片（可选，锚定到第 0 帧做卡点）"},
    "inputs": {"audio": "h3_music/U00.wav"}
  },
  "22": {
    "class_type": "MiniMaxH3AddGuide",
    "_meta": {"title": "Add Guide · 音频锚定"},
    "inputs": {"positive": ["20", 0], "vae": ["3", 0], "audio_vae": ["4", 0], "latent": ["20", 1], "audio": ["21", 0], "frame_idx": 0}
  },
  "30": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 1}
  },
  "31": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "res_multistep"}
  },
  "32": {
    "class_type": "BasicScheduler",
    "inputs": {"model": ["5", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0}
  },
  "33": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["5", 0], "conditioning": ["22", 0]}
  },
  "34": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {"noise": ["30", 0], "guider": ["33", 0], "sampler": ["31", 0], "sigmas": ["32", 0], "latent_image": ["20", 1]}
  },
  "40": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["34", 0], "vae": ["3", 0]}
  },
  "41": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["34", 0], "vae": ["4", 0]}
  },
  "42": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["40", 0], "audio": ["41", 0], "fps": 24.0}
  },
  "43": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["42", 0], "filename_prefix": "stage/U00", "format": "auto", "format.codec": "auto"}
  }
}
