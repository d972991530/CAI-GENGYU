{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "H3 DiT · Ref2VA"},
    "inputs": {"unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3-VL 32B 文本/多模态编码器"},
    "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "视频 VAE"},
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "音频 VAE"},
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}
  },
  "5": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {"title": "ModelSamplingMiniMaxH3"},
    "inputs": {"model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0}
  },
  "100": {
    "class_type": "LoadImage",
    "_meta": {"title": "REF <Picture 1>"},
    "inputs": {"image": "h3_refs/A_c1.png"}
  },
  "101": {
    "class_type": "LoadImage",
    "_meta": {"title": "REF <Picture 2>"},
    "inputs": {"image": "h3_refs/B_c1.png"}
  },
  "20": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": {"title": "H3 Reference to Video"},
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "<Picture 1> and <Picture 2> dance in a white studio.",
      "width": 1344,
      "height": 768,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["100", 0],
      "ref_images.ref_image_1": ["101", 0]
    }
  },
  "30": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 1}
  },
  "31": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "res_multistep"}
  },
  "32": {
    "class_type": "BasicScheduler",
    "inputs": {"model": ["5", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0}
  },
  "33": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["5", 0], "conditioning": ["20", 0]}
  },
  "34": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {"noise": ["30", 0], "guider": ["33", 0], "sampler": ["31", 0], "sigmas": ["32", 0], "latent_image": ["20", 1]}
  },
  "40": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["34", 0], "vae": ["3", 0]}
  },
  "41": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["34", 0], "vae": ["4", 0]}
  },
  "42": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["40", 0], "audio": ["41", 0], "fps": 24.0}
  },
  "43": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["42", 0], "filename_prefix": "stage/U00", "format": "auto", "format.codec": "auto"}
  }
}
